# Ignore development files and directories
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore git
.git/
.gitignore

# Ignore documentation
*.md
docs/

# Ignore environment files
.env*
!.env.sample

# Ignore development configs
.vscode/
.idea/

# Ignore logs
logs/
*.log

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore test files
**/__tests__/
**/*.test.*
**/*.spec.*
coverage/
.nyc_output/

# Ignore build artifacts that aren't needed
frontend/node_modules/
frontend/build/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/**/*.pyc

# Ignore docker files
docker-compose*.yml
Dockerfile*
.dockerignore

# Ignore CI/CD
.github/
